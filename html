        /* =====================================================================
           5. SINTETIZADOR DSP DE CAMPANA CRISTALINA (ESTILO FENDER / GUITARTUNA)
           ===================================================================== */
        function dispararParcialCristal( destino, freq, tipo, tiempoInicio, duracion, gananciaPico, detuneCents ) {
            var osc = audioCtx.createOscillator();
            var gain = audioCtx.createGain();

            osc.type = tipo;
            osc.frequency.setValueAtTime(freq, tiempoInicio);
            if (detuneCents) {
                osc.detune.setValueAtTime(detuneCents, tiempoInicio);
            }

            gain.gain.setValueAtTime(0.0001, tiempoInicio);
            gain.gain.linearRampToValueAtTime(gananciaPico, tiempoInicio + 0.004);
            gain.gain.exponentialRampToValueAtTime(0.0001, tiempoInicio + duracion);

            osc.connect(gain);
            gain.connect(destino);

            osc.start(tiempoInicio);
            osc.stop(tiempoInicio + duracion + 0.01);

            osc.onended = function() {
                try {
                    osc.disconnect();
                    gain.disconnect();
                } catch (e) {}
            };
        }

        function sonarTimbreConfirmacion() {
            if (!estadoConfig.timbreActivo || !audioCtx) return;
            try {
                if (audioCtx.state === "suspended") {
                    audioCtx.resume();
                }

                var t0 = audioCtx.currentTime;
                var masterGain = audioCtx.createGain();
                masterGain.gain.setValueAtTime(0.85, t0);
                masterGain.connect(audioCtx.destination);

                // 1. Transiente percusivo de cristal (0ms): corta la resonancia acústica de la guitarra
                dispararParcialCristal(masterGain, 3520.00, "sine", t0, 0.045, 0.14, 0);
                dispararParcialCristal(masterGain, 2637.02, "triangle", t0, 0.075, 0.12, 0);

                // 2. Golpe fundamental cálido de referencia (0ms): La 5 (880 Hz) + Mi 6 (1318.51 Hz)
                dispararParcialCristal(masterGain, 880.00, "sine", t0, 0.36, 0.24, 0);
                dispararParcialCristal(masterGain, 1318.51, "triangle", t0, 0.28, 0.14, 3);

                // 3. Destello armónico de confirmación (+35ms): acorde cristalino ascendente (La 6 + Do# 7 + Mi 7)
                var tDestello = t0 + 0.035;
                dispararParcialCristal(masterGain, 1760.00, "sine", tDestello, 0.52, 0.28, 0);
                dispararParcialCristal(masterGain, 1760.00, "triangle", tDestello, 0.42, 0.10, -4);
                dispararParcialCristal(masterGain, 2217.46, "sine", tDestello, 0.38, 0.13, 2);
                dispararParcialCristal(masterGain, 2637.02, "sine", tDestello, 0.32, 0.15, 0);

                setTimeout(function() {
                    try { masterGain.disconnect(); } catch (e) {}
                }, 650);
            } catch (e) {}
        }

        /* =====================================================================
           6. ARQUITECTURA AUDIOWORKLET ZERO-ALLOCATION + RESPUESTA EN HILO UI
           ===================================================================== */
        var CODIGO_WORKLET_DSP = [
            "class StrobePitchWorklet extends AudioWorkletProcessor {",
            "  constructor() {",
            "    super();",
            "    this.bufSize = 4096;",
            "    this.ringBuffer = new Float32Array(this.bufSize);",
            "    this.linearBuffer = new Float32Array(this.bufSize);",
            "    this.nsdf = new Float32Array(2048);",
            "    this.writeIndex = 0;",
            "    this.samplesSinceLastAnalysis = 0;",
            "    this.hopSize = 512;",
            "    this.targetHz = 0;",
            "    this.rmsThreshold = 0.015;",
            "    this.gateOpen = false;",
            "    var self = this;",
            "    this.port.onmessage = function(e) {",
            "      var d = e.data;",
            "      if (!d) return;",
            "      if (d.type === 'config') {",
            "        if (typeof d.targetHz === 'number') self.targetHz = d.targetHz;",
            "        if (typeof d.rmsThreshold === 'number') self.rmsThreshold = d.rmsThreshold;",
            "      }",
            "    };",
            "  }",
            "  process(inputs) {",
            "    var input = inputs[0];",
            "    if (!input || !input[0]) return true;",
            "    var channel = input[0];",
            "    var len = channel.length;",
            "    for (var i = 0; i < len; i++) {",
            "      this.ringBuffer[this.writeIndex] = channel[i];",
            "      this.writeIndex = (this.writeIndex + 1) & 4095;",
            "    }",
            "    this.samplesSinceLastAnalysis += len;",
            "    if (this.samplesSinceLastAnalysis >= this.hopSize) {",
            "      this.samplesSinceLastAnalysis = 0;",
            "      if (this.targetHz > 20) {",
            "        var ptr = this.writeIndex;",
            "        var sumSq = 0;",
            "        var mean = 0;",
            "        for (var j = 0; j < 4096; j++) {",
            "          var s = this.ringBuffer[ptr];",
            "          this.linearBuffer[j] = s;",
            "          mean += s;",
            "          ptr = (ptr + 1) & 4095;",
            "        }",
            "        mean /= 4096;",
            "        for (var m = 0; m < 4096; m++) {",
            "          var centered = this.linearBuffer[m] - mean;",
            "          this.linearBuffer[m] = centered;",
            "          sumSq += centered * centered;",
            "        }",
            "        var rms = Math.sqrt(sumSq / 4096);",
            "        var umbralEfectivo = this.gateOpen ? (this.rmsThreshold * 0.55) : this.rmsThreshold;",
            "        if (rms < umbralEfectivo) {",
            "          this.gateOpen = false;",
            "          this.port.postMessage({ freq: -1, clarity: 0 });",
            "        } else {",
            "          var res = this.calcularMPM(sampleRate, this.targetHz);",
            "          if (res.freq > 0) {",
            "            this.gateOpen = true;",
            "          } else {",
            "            this.gateOpen = false;",
            "          }",
            "          this.port.postMessage(res);",
            "        }",
            "      }",
            "    }",
            "    return true;",
            "  }",
            "  calcularMPM(sr, hzObj) {",
            "    var tauObj = sr / hzObj;",
            "    var minTau = Math.max(16, Math.floor(tauObj * 0.70));",
            "    var maxTau = Math.min(2040, Math.ceil(tauObj * 1.40));",
            "    var W = Math.min(1400, 4096 - maxTau - 2);",
            "    var buf = this.linearBuffer;",
            "    var nsdf = this.nsdf;",
            "    var maxGlobal = -1;",
            "    for (var tau = minTau - 1; tau <= maxTau + 1; tau++) {",
            "      var acf = 0;",
            "      var div = 0;",
            "      for (var i = 0; i < W; i++) {",
            "        var x0 = buf[i];",
            "        var xT = buf[i + tau];",
            "        acf += x0 * xT;",
            "        div += x0 * x0 + xT * xT;",
            "      }",
            "      var val = div > 0 ? (2 * acf) / div : 0;",
            "      nsdf[tau] = val;",
            "      if (tau >= minTau && tau <= maxTau && val > maxGlobal) {",
            "        maxGlobal = val;",
            "      }",
            "    }",
            "    if (maxGlobal < 0.72) return { freq: -1, clarity: 0 };",
            "    var umbralPico = Math.max(0.72, maxGlobal * 0.88);",
            "    var mejorTau = -1;",
            "    var mejorVal = -1;",
            "    for (var k = minTau; k <= maxTau; k++) {",
            "      var v = nsdf[k];",
            "      if (v >= umbralPico && v > nsdf[k - 1] && v >= nsdf[k + 1]) {",
            "        mejorTau = k;",
            "        mejorVal = v;",
            "        break;",
            "      }",
            "    }",
            "    if (mejorTau === -1) return { freq: -1, clarity: 0 };",
            "    var y1 = nsdf[mejorTau - 1];",
            "    var y2 = nsdf[mejorTau];",
            "    var y3 = nsdf[mejorTau + 1];",
            "    var denom = y1 - 2 * y2 + y3;",
            "    var delta = 0;",
            "    if (Math.abs(denom) > 1e-7) {",
            "      delta = (y1 - y3) / (2 * denom);",
            "      if (delta > 1) delta = 1;",
            "      else if (delta < -1) delta = -1;",
            "    }",
            "    return { freq: sr / (mejorTau + delta), clarity: mejorVal };",
            "  }",
            "}",
            "registerProcessor('strobe-pitch-worklet', StrobePitchWorklet);"
        ].join("\n");

        var audioCtx = null;
        var mediaStream = null;
        var sourceNode = null;
        var highpassNode = null;
        var lowpassNode = null;
        var workletNode = null;
        var silentGainNode = null;
        var analyserFallbackNode = null;
        var bufferFallback = null;
        var nsdfFallback = new Float32Array(2048);
        var idBucleFallback = null;
        var gateOpenFallback = false;

        // Arreglos pre-alojados en el hilo principal (Zero-Allocation para evitar Garbage Collection)
        var ventanaMediana = new Float64Array(5);
        var copiaOrdenada = new Float64Array(5);
        var totalMuestrasMediana = 0;
        var cursorMediana = 0;
        var frecuenciaSuavizada = 0;
        var contadorSilencioFrames = 0;

        var fraseCandidata = "";
        var inicioFraseCandidata = 0;
        var ultimaFraseAnunciada = "";
        var ultimoTiempoAnuncio = 0;
        var inicioEnZonaAfinada = 0;
        var timbreDisparadoEnEsteBloqueo = false;

        function obtenerMedianaSinAsignacion(nuevaFreq) {
            ventanaMediana[cursorMediana] = nuevaFreq;
            cursorMediana = (cursorMediana + 1) % 5;
            if (totalMuestrasMediana < 5) {
                totalMuestrasMediana++;
            }
            for (var i = 0; i < totalMuestrasMediana; i++) {
                copiaOrdenada[i] = ventanaMediana[i];
            }
            for (var a = 1; a < totalMuestrasMediana; a++) {
                var clave = copiaOrdenada[a];
                var b = a - 1;
                while (b >= 0 && copiaOrdenada[b] > clave) {
                    copiaOrdenada[b + 1] = copiaOrdenada[b];
                    b--;
                }
                copiaOrdenada[b + 1] = clave;
            }
            return copiaOrdenada[Math.floor(totalMuestrasMediana / 2)];
        }

        function actualizarFiltroFrancotirador(hzObjetivo) {
            if (!audioCtx || !highpassNode || !lowpassNode) return;
            var ahora = audioCtx.currentTime;
            highpassNode.frequency.setTargetAtTime(Math.max(40, hzObjetivo * 0.68), ahora, 0.015);
            lowpassNode.frequency.setTargetAtTime(Math.min(2000, hzObjetivo * 1.42), ahora, 0.015);
        }

        function procesarResultadoFrecuencia(freqCruda, claridad) {
            if (!microfonoActivo || indiceCuerdaActiva === null) {
                senalDetectadaActiva = false;
                return;
            }

            var ahora = performance.now();
            var midiObjetivo = CATALOGO_AFINACIONES[estadoConfig.indiceAfinacion][indiceCuerdaActiva];
            var hzObjetivo = midiAFrecuencia(midiObjetivo);

            if (freqCruda > 0) {
                contadorSilencioFrames = 0;
                var freqMediana = obtenerMedianaSinAsignacion(freqCruda);

                if (frecuenciaSuavizada === 0) {
                    frecuenciaSuavizada = freqMediana;
                } else {
                    var diffRelativa = Math.abs(freqMediana - frecuenciaSuavizada) / hzObjetivo;
                    var alpha = diffRelativa > 0.008 ? 0.65 : 0.28;
                    frecuenciaSuavizada = frecuenciaSuavizada + alpha * (freqMediana - frecuenciaSuavizada);
                }

                var cents = (1200 * Math.log(frecuenciaSuavizada / hzObjetivo)) / Math.LN2;

                senalDetectadaActiva = true;
                actualizarTelemetriaEstudio(frecuenciaSuavizada, cents);

                var nuevaFrase = "";
                var enPuntoExacto = Math.abs(cents) <= 2.2;

                if (cents < -10) {
                    nuevaFrase = "Demasiado bajo, suba el tono.";
                } else if (cents < -2.2) {
                    nuevaFrase = "Un poco bajo.";
                } else if (enPuntoExacto) {
                    nuevaFrase = "Mantenlo ahí.";
                } else if (cents <= 10) {
                    nuevaFrase = "Un poco alto.";
                } else {
                    nuevaFrase = "Demasiado alto, baje el tono.";
                }

                if (enPuntoExacto) {
                    consolaCentral.classList.add("afinado-lock");
                    notaGigante.classList.add("nota-afinada");
                    if (inicioEnZonaAfinada === 0) {
                        inicioEnZonaAfinada = ahora;
                    } else if (!timbreDisparadoEnEsteBloqueo && (ahora - inicioEnZonaAfinada >= 450)) {
                        timbreDisparadoEnEsteBloqueo = true;
                        sonarTimbreConfirmacion();
                    }
                } else {
                    consolaCentral.classList.remove("afinado-lock");
                    notaGigante.classList.remove("nota-afinada");
                    if (Math.abs(cents) > 4.5) {
                        inicioEnZonaAfinada = 0;
                        timbreDisparadoEnEsteBloqueo = false;
                    }
                }

                if (nuevaFrase !== fraseCandidata) {
                    fraseCandidata = nuevaFrase;
                    inicioFraseCandidata = ahora;
                } else if (ahora - inicioFraseCandidata >= 400) {
                    if (nuevaFrase !== ultimaFraseAnunciada && (ahora - ultimoTiempoAnuncio >= 950)) {
                        ultimaFraseAnunciada = nuevaFrase;
                        ultimoTiempoAnuncio = ahora;
                        display.textContent = nuevaFrase;
                    }
                }
            } else {
                contadorSilencioFrames++;
                if (contadorSilencioFrames > 4) {
                    senalDetectadaActiva = false;
                    totalMuestrasMediana = 0;
                    cursorMediana = 0;
                    frecuenciaSuavizada = 0;
                    consolaCentral.classList.remove("afinado-lock");
                    notaGigante.classList.remove("nota-afinada");
                }
            }
        }

        /* =====================================================================
           7. MOTOR DE RESPALDO (FALLBACK ZERO-ALLOCATION SI SE ABRE EN FILE://)
           ===================================================================== */
        function calcularMPMFallback(buf, sampleRate, hzObjetivo) {
            var N = buf.length;
            var mean = 0;
            for (var i = 0; i < N; i++) {
                mean += buf[i];
            }
            mean /= N;

            var sumaCuadrados = 0;
            for (var m = 0; m < N; m++) {
                var c = buf[m] - mean;
                buf[m] = c;
                sumaCuadrados += c * c;
            }

            var rms = Math.sqrt(sumaCuadrados / N);
            var umbral = gateOpenFallback ? (estadoConfig.umbralRms * 0.55) : estadoConfig.umbralRms;
            if (rms < umbral) {
                gateOpenFallback = false;
                return -1;
            }

            var tauObjetivo = sampleRate / hzObjetivo;
            var minTau = Math.max(16, Math.floor(tauObjetivo * 0.70));
            var maxTau = Math.min(2040, Math.ceil(tauObjetivo * 1.40));
            var W = Math.min(1400, N - maxTau - 2);
            var maxGlobal = -1;

            for (var tau = minTau - 1; tau <= maxTau + 1; tau++) {
                var acf = 0;
                var divisor = 0;
                for (var j = 0; j < W; j++) {
                    var x0 = buf[j];
                    var xTau = buf[j + tau];
                    acf += x0 * xTau;
                    divisor += x0 * x0 + xTau * xTau;
                }
                var val = divisor > 0 ? (2 * acf) / divisor : 0;
                nsdfFallback[tau] = val;
                if (tau >= minTau && tau <= maxTau && val > maxGlobal) {
                    maxGlobal = val;
                }
            }

            if (maxGlobal < 0.72) {
                gateOpenFallback = false;
                return -1;
            }

            var umbralPico = Math.max(0.72, maxGlobal * 0.88);
            var mejorTau = -1;

            for (var k = minTau; k <= maxTau; k++) {
                var v = nsdfFallback[k];
                if (v >= umbralPico && v > nsdfFallback[k - 1] && v >= nsdfFallback[k + 1]) {
                    mejorTau = k;
                    break;
                }
            }

            if (mejorTau === -1) {
                gateOpenFallback = false;
                return -1;
            }

            gateOpenFallback = true;
            var y1 = nsdfFallback[mejorTau - 1];
            var y2 = nsdfFallback[mejorTau];
            var y3 = nsdfFallback[mejorTau + 1];
            var denom = y1 - 2 * y2 + y3;
            var delta = 0;
            if (Math.abs(denom) > 1e-7) {
                delta = (y1 - y3) / (2 * denom);
                if (delta > 1) delta = 1;
                else if (delta < -1) delta = -1;
            }

            return sampleRate / (mejorTau + delta);
        }

        function procesarCicloFallback() {
            if (!microfonoActivo || !analyserFallbackNode) return;
            if (indiceCuerdaActiva !== null) {
                analyserFallbackNode.getFloatTimeDomainData(bufferFallback);
                var midiObjetivo = CATALOGO_AFINACIONES[estadoConfig.indiceAfinacion][indiceCuerdaActiva];
                var hzObjetivo = midiAFrecuencia(midiObjetivo);
                var freq = calcularMPMFallback(bufferFallback, audioCtx.sampleRate, hzObjetivo);
                procesarResultadoFrecuencia(freq, 1.0);
            } else {
                senalDetectadaActiva = false;
            }
            idBucleFallback = requestAnimationFrame(procesarCicloFallback);
        }

        /* =====================================================================
           8. GESTIÓN DE WAKE LOCK (PANTALLA SIEMPRE ENCENDIDA AL AFINAR)
           ===================================================================== */
        function solicitarWakeLock() {
            if ("wakeLock" in navigator && navigator.wakeLock && navigator.wakeLock.request) {
                navigator.wakeLock.request("screen").then(function(sentinel) {
                    wakeLockSentinel = sentinel;
                }).catch(function() {});
            }
        }

        function liberarWakeLock() {
            if (wakeLockSentinel) {
                try { wakeLockSentinel.release(); } catch (e) {}
                wakeLockSentinel = null;
            }
        }

        /* =====================================================================
           9. ENCENDIDO Y APAGADO DEL MICRÓFONO (AUDIOWORKLET + FALLBACK)
           ===================================================================== */
        function activarInterfazMicrofonoEncendido() {
            microfonoActivo = true;
            textoBtnMic.textContent = "Apagar micrófono";
            btnMic.classList.add("activo");
            solicitarWakeLock();

            if (indiceCuerdaActiva === null) {
                display.textContent = "Micrófono encendido. Seleccione una cuerda para afinar.";
            } else {
                var notaHablada = btnCuerdas[indiceCuerdaActiva].getAttribute("data-nota-hablada");
                display.textContent = "Afinando " + notaHablada + ". Escuchando...";
            }
        }

        function iniciarModoFallbackAnalyser() {
            analyserFallbackNode = audioCtx.createAnalyser();
            analyserFallbackNode.fftSize = 4096;
            bufferFallback = new Float32Array(4096);
            lowpassNode.connect(analyserFallbackNode);
            activarInterfazMicrofonoEncendido();
            idBucleFallback = requestAnimationFrame(procesarCicloFallback);
        }

        function encenderMicrofono() {
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                display.textContent = "El navegador requiere HTTPS o instalar la aplicación web para usar el micrófono.";
                return;
            }

            navigator.mediaDevices.getUserMedia({
                audio: {
                    echoCancellation: false,
                    noiseSuppression: false,
                    autoGainControl: false,
                    channelCount: 1,
                    latency: 0
                }
            }).then(function(stream) {
                mediaStream = stream;
                var AudioContextClass = window.AudioContext || window.webkitAudioContext;
                audioCtx = new AudioContextClass({ latencyHint: "interactive" });
                if (audioCtx.state === "suspended") {
                    audioCtx.resume();
                }

                sourceNode = audioCtx.createMediaStreamSource(mediaStream);

                highpassNode = audioCtx.createBiquadFilter();
                highpassNode.type = "highpass";
                highpassNode.Q.value = 0.707;

                lowpassNode = audioCtx.createBiquadFilter();
                lowpassNode.type = "lowpass";
                lowpassNode.Q.value = 0.707;

                sourceNode.connect(highpassNode);
                highpassNode.connect(lowpassNode);

                var hzInicial = 0;
                if (indiceCuerdaActiva !== null) {
                    var midi = CATALOGO_AFINACIONES[estadoConfig.indiceAfinacion][indiceCuerdaActiva];
                    hzInicial = midiAFrecuencia(midi);
                    actualizarFiltroFrancotirador(hzInicial);
                }

                if (audioCtx.audioWorklet && typeof Blob !== "undefined" && typeof URL !== "undefined") {
                    var blob = new Blob([CODIGO_WORKLET_DSP], { type: "application/javascript" });
                    var urlWorklet = URL.createObjectURL(blob);

                    audioCtx.audioWorklet.addModule(urlWorklet).then(function() {
                        URL.revokeObjectURL(urlWorklet);
                        workletNode = new AudioWorkletNode(audioCtx, "strobe-pitch-worklet");
                        workletNode.port.onmessage = function(e) {
                            if (e.data) {
                                procesarResultadoFrecuencia(e.data.freq, e.data.clarity);
                            }
                        };

                        silentGainNode = audioCtx.createGain();
                        silentGainNode.gain.value = 0;

                        lowpassNode.connect(workletNode);
                        workletNode.connect(silentGainNode);
                        silentGainNode.connect(audioCtx.destination);

                        notificarObjetivoAlMotor(hzInicial);
                        activarInterfazMicrofonoEncendido();
                    }).catch(function() {
                        URL.revokeObjectURL(urlWorklet);
                        iniciarModoFallbackAnalyser();
                    });
                } else {
                    iniciarModoFallbackAnalyser();
                }
            }).catch(function() {
                microfonoActivo = false;
                textoBtnMic.textContent = "Activar micrófono";
                btnMic.classList.remove("activo");
                display.textContent = "Permiso denegado o archivo abierto sin servidor seguro.";
            });
        }

        function apagarMicrofono() {
            microfonoActivo = false;
            reiniciarEstadoEstabilizador();
            liberarWakeLock();

            if (idBucleFallback) {
                cancelAnimationFrame(idBucleFallback);
                idBucleFallback = null;
            }
            if (workletNode) {
                try {
                    workletNode.port.onmessage = null;
                    workletNode.disconnect();
                } catch (e) {}
                workletNode = null;
            }
            if (silentGainNode) {
                try { silentGainNode.disconnect(); } catch (e) {}
                silentGainNode = null;
            }
            if (analyserFallbackNode) {
                try { analyserFallbackNode.disconnect(); } catch (e) {}
                analyserFallbackNode = null;
            }
            if (mediaStream) {
                var tracks = mediaStream.getTracks();
                for (var i = 0; i < tracks.length; i++) {
                    tracks[i].stop();
                }
                mediaStream = null;
            }
            if (audioCtx) {
                try { audioCtx.close(); } catch (e) {}
                audioCtx = null;
            }

            consolaCentral.classList.remove("afinado-lock");
            notaGigante.classList.remove("nota-afinada");
            textoBtnMic.textContent = "Activar micrófono";
            btnMic.classList.remove("activo");
            display.textContent = "Micrófono en pausa.";
        }

        btnMic.addEventListener("click", function() {
            if (microfonoActivo) {
                apagarMicrofono();
            } else {
                encenderMicrofono();
            }
        });

        /* =====================================================================
           10. ANIMACIÓN ESTROBOSCÓPICA INDEPENDIENTE DE FPS (60/90/120 Hz)
           ===================================================================== */
        var faseStrobe = 0;
        var ultimoTimestampFrame = 0;

        function animarEstroboscopio(timestamp) {
            if (!ultimoTimestampFrame) ultimoTimestampFrame = timestamp;
            var dt = (timestamp - ultimoTimestampFrame) / 16.6667;
            if (dt > 4) dt = 1;
            ultimoTimestampFrame = timestamp;

            if (microfonoActivo && senalDetectadaActiva && Math.abs(desviacionCentsActual) > 0.08) {
                var velocidad = Math.max(-45, Math.min(45, desviacionCentsActual)) * 0.18 * dt;
                faseStrobe = (faseStrobe + velocidad) % 1120;
                banda1.style.backgroundPositionX = (faseStrobe * 1.5).toFixed(2) + "px";
                banda2.style.backgroundPositionX = faseStrobe.toFixed(2) + "px";
                banda3.style.backgroundPositionX = (faseStrobe * 0.5).toFixed(2) + "px";
            }
            requestAnimationFrame(animarEstroboscopio);
        }

        /* =====================================================================
           11. INICIALIZACIÓN, SEGUNDO PLANO Y REGISTRO PWA SEGURO
           ===================================================================== */
        cargarConfiguracionLocal();
        sincronizarControlesConfigUI();
        sincronizarClavijasYVisor();
        requestAnimationFrame(animarEstroboscopio);

        document.addEventListener("visibilitychange", function() {
            if (document.hidden && microfonoActivo) {
                apagarMicrofono();
            }
        });

        if ("serviceWorker" in navigator && (location.protocol === "https:" || location.hostname === "localhost")) {
            window.addEventListener("load", function() {
                navigator.serviceWorker.register("./sw.js").catch(function() {});
            });
        }
    </script>
</body>
