<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="theme-color" content="#101012">
    <link rel="manifest" href="./manifest.json">
    <title>Afinador Pro</title>
    <style>
        /* ==========================================
           SISTEMA DE DISEÑO DARK MODE INSTRUMENTAL
           ========================================== */
        :root {
            --bg-base: #101012;
            --surface-elevated: #18181B;
            --surface-interactive: #27272A;
            --border-subtle: #27272A;
            --border-strong: #3F3F46;
            --border-active: #E4E4E7;

            --text-primary: #F4F4F5;
            --text-secondary: #A1A1AA;
            --text-muted: #71717A;

            --accent-studio: #38BDF8;
            --accent-surface: rgba(56, 189, 248, 0.12);

            --space-1: 8px;
            --space-2: 16px;
            --space-3: 24px;

            --radius-sm: 10px;
            --radius-md: 14px;

            --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            --font-mono: ui-monospace, "SF Mono", "JetBrains Mono", "Roboto Mono", monospace;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
            -webkit-tap-highlight-color: transparent;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            background-color: var(--bg-base);
            color: var(--text-primary);
            font-family: var(--font-sans);
            height: 100dvh;
            overflow: hidden;
            position: relative;
        }

        button {
            background: none;
            border: none;
            color: inherit;
            font: inherit;
            cursor: pointer;
            outline: none;
            text-shadow: none;
            box-shadow: none;
            touch-action: manipulation;
        }

        button * {
            pointer-events: none;
        }

        /* ==========================================
           1. VISTA PRINCIPAL DEL AFINADOR
           ========================================== */
        #vista-principal {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding-top: max(var(--space-2), calc(env(safe-area-inset-top, 0px) + var(--space-2)));
            padding-bottom: max(var(--space-2), calc(env(safe-area-inset-bottom, 0px) + var(--space-2)));
            padding-inline: max(var(--space-2), env(safe-area-inset-left, 16px));
            gap: var(--space-2);
        }

        header {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            min-height: 48px;
            flex-shrink: 0;
        }

        h1 {
            font-size: 18px;
            font-weight: 600;
            letter-spacing: -0.02em;
            color: var(--text-primary);
        }

        #btn-config {
            width: 48px;
            height: 48px;
            border-radius: var(--radius-md);
            display: flex;
            justify-content: center;
            align-items: center;
            color: var(--text-primary);
            background-color: var(--surface-elevated);
            border: 1px solid var(--border-subtle);
            transition: background-color 0.15s ease, border-color 0.15s ease;
        }

        #btn-config:active {
            background-color: var(--surface-interactive);
            border-color: var(--border-strong);
        }

        #btn-config svg {
            width: 22px;
            height: 22px;
            stroke: currentColor;
        }

        /* ==========================================
           2. CONSOLA CENTRAL ESTROBOSCÓPICA
           ========================================== */
        main {
            width: 100%;
            flex: 1;
            min-height: 0;
            background-color: var(--surface-elevated);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            padding: 18px var(--space-2);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        main.afinado-lock {
            border-color: var(--accent-studio);
        }

        .strobe-viewport {
            position: relative;
            width: 100%;
            height: 80px;
            background-color: var(--bg-base);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-evenly;
            padding: 6px 0;
            flex-shrink: 0;
            contain: strict;
        }

        .strobe-center-reticle {
            position: absolute;
            top: 0;
            bottom: 0;
            left: 50%;
            width: 2px;
            background-color: var(--accent-studio);
            transform: translateX(-50%);
            z-index: 3;
        }

        .strobe-band {
            width: 100%;
            height: 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.03);
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            will-change: background-position;
            transform: translateZ(0);
        }

        #banda-1 {
            opacity: 0.45;
            background-image: repeating-linear-gradient(
                90deg,
                var(--accent-studio) 0px,
                var(--accent-studio) 14px,
                transparent 14px,
                transparent 28px
            );
        }

        #banda-2 {
            height: 22px;
            opacity: 0.90;
            background-image: repeating-linear-gradient(
                90deg,
                var(--accent-studio) 0px,
                var(--accent-studio) 28px,
                transparent 28px,
                transparent 56px
            );
        }

        #banda-3 {
            opacity: 0.45;
            background-image: repeating-linear-gradient(
                90deg,
                var(--accent-studio) 0px,
                var(--accent-studio) 56px,
                transparent 56px,
                transparent 112px
            );
        }

        .readout-cluster {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin: auto 0;
        }

        #nota-gigante {
            font-family: var(--font-mono);
            font-size: 54px;
            font-weight: 700;
            line-height: 1;
            min-height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            letter-spacing: -0.03em;
            color: var(--text-muted);
        }

        #nota-gigante.nota-activa {
            color: var(--text-primary);
        }

        #nota-gigante.nota-afinada {
            color: var(--accent-studio);
        }

        .telemetria-bar {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            font-family: var(--font-mono);
            font-size: 13px;
            font-weight: 600;
            color: var(--text-secondary);
            background-color: var(--bg-base);
            padding: 6px 14px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-subtle);
            min-height: 32px;
        }

        .separador-telemetria {
            width: 1px;
            height: 12px;
            background-color: var(--border-strong);
        }

        #lectura-cents {
            color: var(--text-primary);
        }

        #display-interactivo {
            font-size: 15px;
            font-weight: 500;
            color: var(--text-secondary);
            text-align: center;
            width: 100%;
            min-height: 44px;
            padding: var(--space-1) var(--space-2);
            background-color: var(--bg-base);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        /* ==========================================
           3. SELECTORES DE CLAVIJAS Y MICRÓFONO
           ========================================== */
        section {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: var(--space-2);
            flex-shrink: 0;
        }

        #contenedor-cuerdas {
            width: 100%;
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: repeat(3, 56px);
            gap: var(--space-1);
            grid-template-areas:
                "cuerda6 cuerda3"
                "cuerda5 cuerda2"
                "cuerda4 cuerda1";
        }

        #cuerda-1 { grid-area: cuerda1; }
        #cuerda-2 { grid-area: cuerda2; }
        #cuerda-3 { grid-area: cuerda3; }
        #cuerda-4 { grid-area: cuerda4; }
        #cuerda-5 { grid-area: cuerda5; }
        #cuerda-6 { grid-area: cuerda6; }

        .btn-cuerda {
            background-color: var(--surface-elevated);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            font-family: var(--font-mono);
            font-size: 17px;
            font-weight: 600;
            color: var(--text-secondary);
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            height: 100%;
            transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
        }

        .btn-cuerda:active {
            background-color: var(--surface-interactive);
        }

        .btn-cuerda.activa {
            background-color: var(--surface-interactive);
            border: 2px solid var(--accent-studio);
            color: var(--text-primary);
        }

        #btn-mic {
            width: 100%;
            min-height: 60px;
            padding: 0 var(--space-3);
            border-radius: var(--radius-md);
            background-color: var(--surface-elevated);
            border: 1px solid var(--border-strong);
            color: var(--text-primary);
            font-size: 16px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: background-color 0.15s ease, border-color 0.15s ease;
        }

        #btn-mic.activo {
            background-color: var(--surface-interactive);
            border: 2px solid var(--accent-studio);
            color: var(--text-primary);
        }

        .icono-mic {
            width: 20px;
            height: 20px;
            stroke: var(--accent-studio);
            flex-shrink: 0;
        }

        /* ==========================================
           4. PANEL DE CONFIGURACIÓN
           ========================================== */
        #vista-config {
            width: 100%;
            height: 100dvh;
            background-color: var(--bg-base);
            display: none;
            flex-direction: column;
            padding-top: max(var(--space-2), calc(env(safe-area-inset-top, 0px) + var(--space-2)));
            padding-bottom: max(var(--space-2), calc(env(safe-area-inset-bottom, 0px) + var(--space-2)));
            padding-inline: max(var(--space-2), env(safe-area-inset-left, 16px));
            gap: var(--space-2);
        }

        .config-nav {
            width: 100%;
            min-height: 48px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid var(--border-subtle);
            padding-bottom: 12px;
            flex-shrink: 0;
        }

        #btn-atras-config {
            min-height: 44px;
            padding: 0 14px;
            background-color: var(--surface-elevated);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
            color: var(--text-primary);
            font-size: 15px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        #btn-atras-config:active {
            background-color: var(--surface-interactive);
            border-color: var(--border-strong);
        }

        #btn-atras-config svg {
            width: 18px;
            height: 18px;
            stroke: currentColor;
        }

        .config-titulo {
            font-size: 18px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .config-lista {
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 12px;
            padding-top: 4px;
        }

        .config-item-btn {
            width: 100%;
            min-height: 74px;
            background-color: var(--surface-elevated);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            padding: 14px var(--space-2);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: var(--space-2);
            text-align: left;
            transition: background-color 0.15s ease, border-color 0.15s ease;
        }

        .config-item-btn:active {
            background-color: var(--surface-interactive);
            border-color: var(--border-strong);
        }

        .config-item-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .config-item-title {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .config-item-value {
            font-size: 13px;
            font-weight: 500;
            color: var(--text-secondary);
        }

        .switch-pill {
            width: 46px;
            height: 26px;
            border-radius: 999px;
            background-color: var(--surface-interactive);
            border: 1px solid var(--border-strong);
            position: relative;
            flex-shrink: 0;
            transition: background-color 0.15s ease, border-color 0.15s ease;
        }

        .switch-Knob {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background-color: var(--text-secondary);
            position: absolute;
            top: 2px;
            left: 2px;
            transition: transform 0.15s ease, background-color 0.15s ease;
        }

        .config-item-btn[aria-checked="true"] .switch-pill {
            background-color: var(--accent-surface);
            border-color: var(--accent-studio);
        }

        .config-item-btn[aria-checked="true"] .switch-Knob {
            transform: translateX(20px);
            background-color: var(--accent-studio);
        }

        .chevron-icon {
            width: 20px;
            height: 20px;
            stroke: var(--text-secondary);
            flex-shrink: 0;
        }

        .config-card-estatica {
            width: 100%;
            background-color: var(--surface-elevated);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            padding: 14px var(--space-2);
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .calibracion-row {
            display: grid;
            grid-template-columns: 64px 1fr 64px;
            gap: var(--space-1);
            align-items: center;
        }

        .btn-calibrar {
            height: 52px;
            background-color: var(--surface-interactive);
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-sm);
            font-family: var(--font-mono);
            font-size: 22px;
            font-weight: 700;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-calibrar:active {
            border-color: var(--accent-studio);
        }

        #valor-a4 {
            height: 52px;
            background-color: var(--bg-base);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
            font-family: var(--font-mono);
            font-size: 17px;
            font-weight: 700;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* ==========================================
           5. VENTANAS EMERGENTES (MODALES DE SELECCIÓN)
           ========================================== */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background-color: rgba(16, 16, 18, 0.88);
            z-index: 100;
            display: none;
            flex-direction: column;
            justify-content: flex-end;
            padding-top: max(var(--space-3), env(safe-area-inset-top, 24px));
        }

        .modal-sheet {
            width: 100%;
            max-height: 82dvh;
            background-color: var(--surface-elevated);
            border-top: 1px solid var(--border-strong);
            border-top-left-radius: 20px;
            border-top-right-radius: 20px;
            padding-top: var(--space-2);
            padding-bottom: max(var(--space-2), calc(env(safe-area-inset-bottom, 0px) + var(--space-2)));
            padding-inline: max(var(--space-2), env(safe-area-inset-left, 16px));
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .modal-sheet-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border-subtle);
            flex-shrink: 0;
        }

        .modal-sheet-title {
            font-size: 16px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .modal-opciones-lista {
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 8px;
            padding: 4px 0;
        }

        .opcion-modal-btn {
            width: 100%;
            min-height: 54px;
            padding: 12px 16px;
            background-color: var(--bg-base);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
            color: var(--text-secondary);
            font-size: 15px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: space-between;
            text-align: left;
        }

        .opcion-modal-btn:active {
            background-color: var(--surface-interactive);
        }

        .opcion-modal-btn.seleccionada {
            background-color: var(--surface-interactive);
            border-color: var(--accent-studio);
            color: var(--text-primary);
        }

        .marca-seleccion {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: transparent;
            flex-shrink: 0;
        }

        .opcion-modal-btn.seleccionada .marca-seleccion {
            background-color: var(--accent-studio);
        }
    </style>
</head>
<body>

    <!-- ==========================================
         1. VISTA PRINCIPAL DEL AFINADOR
         ========================================== -->
    <div id="vista-principal">
        <header>
            <!-- FLICK 1: Título -->
            <h1>Afinador Pro</h1>
            <!-- FLICK 2: Configuración -->
            <button type="button" id="btn-config" aria-label="Configuración">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
            </button>
        </header>

        <!-- ZONA CENTRAL -->
        <main id="consola-central">
            <div class="strobe-viewport" aria-hidden="true">
                <div class="strobe-center-reticle"></div>
                <div class="strobe-band" id="banda-1"></div>
                <div class="strobe-band" id="banda-2"></div>
                <div class="strobe-band" id="banda-3"></div>
            </div>

            <div class="readout-cluster" aria-hidden="true">
                <div id="nota-gigante">Mi 2</div>
                <div class="telemetria-bar">
                    <span id="lectura-hz">82.41 Hz</span>
                    <span class="separador-telemetria"></span>
                    <span id="lectura-cents">±0.0 cents</span>
                </div>
            </div>

            <!-- FLICK 3: Centro Interactivo Único para el Lector de Pantalla -->
            <div id="display-interactivo" tabindex="0" aria-live="polite" role="status">
                Seleccione una cuerda para comenzar.
            </div>
        </main>

        <!-- ZONA INFERIOR: CLAVIJAS Y MICRÓFONO -->
        <section>
            <!-- FLICKS 4 al 9: Clavijas de 1.ª a 6.ª sin la palabra "Botón" -->
            <div id="contenedor-cuerdas">
                <button type="button" class="btn-cuerda" id="cuerda-1" data-index="0" data-base-label="Primera cuerda, Mi 4" data-nota-visual="Mi 4" data-nota-hablada="Mi 4" data-hz="329.63" aria-label="Primera cuerda, Mi 4" aria-pressed="false">Mi 4</button>
                <button type="button" class="btn-cuerda" id="cuerda-2" data-index="1" data-base-label="Segunda cuerda, Si 3" data-nota-visual="Si 3" data-nota-hablada="Si 3" data-hz="246.94" aria-label="Segunda cuerda, Si 3" aria-pressed="false">Si 3</button>
                <button type="button" class="btn-cuerda" id="cuerda-3" data-index="2" data-base-label="Tercera cuerda, Sol 3" data-nota-visual="Sol 3" data-nota-hablada="Sol 3" data-hz="196.00" aria-label="Tercera cuerda, Sol 3" aria-pressed="false">Sol 3</button>
                <button type="button" class="btn-cuerda" id="cuerda-4" data-index="3" data-base-label="Cuarta cuerda, Re 3" data-nota-visual="Re 3" data-nota-hablada="Re 3" data-hz="146.83" aria-label="Cuarta cuerda, Re 3" aria-pressed="false">Re 3</button>
                <button type="button" class="btn-cuerda" id="cuerda-5" data-index="4" data-base-label="Quinta cuerda, La 2" data-nota-visual="La 2" data-nota-hablada="La 2" data-hz="110.00" aria-label="Quinta cuerda, La 2" aria-pressed="false">La 2</button>
                <button type="button" class="btn-cuerda" id="cuerda-6" data-index="5" data-base-label="Sexta cuerda, Mi 2" data-nota-visual="Mi 2" data-nota-hablada="Mi 2" data-hz="82.41" aria-label="Sexta cuerda, Mi 2" aria-pressed="false">Mi 2</button>
            </div>

            <!-- FLICK 10: Botón de Control Principal -->
            <button type="button" id="btn-mic">
                <svg class="icono-mic" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
