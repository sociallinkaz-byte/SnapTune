    <script>
        /* =====================================================================
           1. REFERENCIAS DEL DOM Y ESTADO GLOBAL CON PERSISTENCIA SEGURA
           ===================================================================== */
        var vistaPrincipal = document.getElementById("vista-principal");
        var vistaConfig = document.getElementById("vista-config");
        var modalAfinacion = document.getElementById("modal-afinacion");
        var modalNomenclatura = document.getElementById("modal-nomenclatura");

        var consolaCentral = document.getElementById("consola-central");
        var display = document.getElementById("display-interactivo");
        var notaGigante = document.getElementById("nota-gigante");
        var lecturaHz = document.getElementById("lectura-hz");
        var lecturaCents = document.getElementById("lectura-cents");

        var btnConfig = document.getElementById("btn-config");
        var btnAtrasConfig = document.getElementById("btn-atras-config");

        var btnToggleTimbre = document.getElementById("btn-toggle-timbre");
        var valorVisualTimbre = document.getElementById("valor-visual-timbre");

        var btnAbrirAfinacion = document.getElementById("btn-abrir-afinacion");
        var valorVisualAfinacion = document.getElementById("valor-visual-afinacion");
        var botonesOpcionAfinacion = document.querySelectorAll("#lista-opciones-afinacion .opcion-modal-btn");

        var btnAbrirNomenclatura = document.getElementById("btn-abrir-nomenclatura");
        var valorVisualNomenclatura = document.getElementById("valor-visual-nomenclatura");
        var botonesOpcionNomenclatura = document.querySelectorAll("#lista-opciones-nomenclatura .opcion-modal-btn");

        var btnA4Menos = document.getElementById("btn-a4-menos");
        var btnA4Mas = document.getElementById("btn-a4-mas");
        var valorA4 = document.getElementById("valor-a4");

        var btnMic = document.getElementById("btn-mic");
        var textoBtnMic = document.getElementById("texto-btn-mic");
        var btnCuerdas = [
            document.getElementById("cuerda-1"),
            document.getElementById("cuerda-2"),
            document.getElementById("cuerda-3"),
            document.getElementById("cuerda-4"),
            document.getElementById("cuerda-5"),
            document.getElementById("cuerda-6")
        ];

        var banda1 = document.getElementById("banda-1");
        var banda2 = document.getElementById("banda-2");
        var banda3 = document.getElementById("banda-3");

        var estadoConfig = {
            indiceAfinacion: 0,
            cifrado: "latino",
            timbreActivo: true,
            calibracionA4: 440,
            umbralRms: 0.015
        };

        var indiceCuerdaActiva = null;
        var microfonoActivo = false;
        var wakeLockSentinel = null;

        /* =====================================================================
           2. TABLAS DE TEORÍA MUSICAL Y SINCRONIZACIÓN
           ===================================================================== */
        var NOMBRES_LATINO = ["Do", "Do#", "Re", "Mib", "Mi", "Fa", "Fa#", "Sol", "Sol#", "La", "Sib", "Si"];
        var NOMBRES_AMERICANO = ["C", "C#", "D", "Eb", "E", "F", "F#", "G", "G#", "A", "Bb", "B"];
        var ORDINALES_CUERDA = [
            "Primera cuerda",
            "Segunda cuerda",
            "Tercera cuerda",
            "Cuarta cuerda",
            "Quinta cuerda",
            "Sexta cuerda"
        ];

        var NOMBRES_AFINACIONES = [
            "Estándar (Mi / E)",
            "Medio tono abajo (Mib / Eb)",
            "Un tono abajo (Re / D)",
            "Tono y medio abajo (Do# / C#)",
            "Dos tonos abajo (Do / C)",
            "Barítono estándar (Si / B)",
            "Drop D (6.ª en Re)",
            "Drop C# (Medio tono abajo)",
            "Drop C (6.ª en Do)",
            "Drop B (6.ª en Si)",
            "Drop A (6.ª en La)",
            "Double Drop D (1.ª y 6.ª en Re)",
            "DADGAD (Celta / Acústica)",
            "Open D (Re Mayor abierto)",
            "Open G (Sol Mayor abierto)",
            "Open E (Mi Mayor abierto)",
            "Open A (La Mayor abierto)",
            "Open C (Do Mayor abierto)",
            "Open Dm (Re Menor abierto)",
            "Modal C (C G C F C E)"
        ];

        var CATALOGO_AFINACIONES = [
            [64, 59, 55, 50, 45, 40],
            [63, 58, 54, 49, 44, 39],
            [62, 57, 53, 48, 43, 38],
            [61, 56, 52, 47, 42, 37],
            [60, 55, 51, 46, 41, 36],
            [59, 54, 50, 45, 40, 35],
            [64, 59, 55, 50, 45, 38],
            [63, 58, 54, 49, 44, 37],
            [62, 57, 53, 48, 43, 36],
            [61, 56, 52, 47, 42, 35],
            [59, 54, 50, 45, 40, 33],
            [62, 59, 55, 50, 45, 38],
            [62, 57, 55, 50, 45, 38],
            [62, 57, 54, 50, 45, 38],
            [62, 59, 55, 50, 43, 38],
            [64, 59, 56, 52, 47, 40],
            [64, 61, 57, 52, 45, 40],
            [64, 60, 55, 48, 43, 36],
            [62, 57, 53, 50, 45, 38],
            [64, 60, 53, 55, 48, 36]
        ];

        function guardarConfiguracionLocal() {
            try {
                localStorage.setItem("afinador_pro_cfg_v2", JSON.stringify({
                    indiceAfinacion: estadoConfig.indiceAfinacion,
                    cifrado: estadoConfig.cifrado,
                    timbreActivo: estadoConfig.timbreActivo,
                    calibracionA4: estadoConfig.calibracionA4
                }));
            } catch (e) {}
        }

        function cargarConfiguracionLocal() {
            try {
                var raw = localStorage.getItem("afinador_pro_cfg_v2");
                if (!raw) return;
                var parsed = JSON.parse(raw);
                if (typeof parsed.indiceAfinacion === "number" && parsed.indiceAfinacion >= 0 && parsed.indiceAfinacion < CATALOGO_AFINACIONES.length) {
                    estadoConfig.indiceAfinacion = parsed.indiceAfinacion;
                }
                if (parsed.cifrado === "latino" || parsed.cifrado === "americano") {
                    estadoConfig.cifrado = parsed.cifrado;
                }
                if (typeof parsed.timbreActivo === "boolean") {
                    estadoConfig.timbreActivo = parsed.timbreActivo;
                }
                if (typeof parsed.calibracionA4 === "number" && parsed.calibracionA4 >= 432 && parsed.calibracionA4 <= 445) {
                    estadoConfig.calibracionA4 = parsed.calibracionA4;
                }
            } catch (e) {}
        }

        function midiAFrecuencia(midi) {
            return estadoConfig.calibracionA4 * Math.pow(2, (midi - 69) / 12);
        }

        function formatearNota(midi) {
            var indiceNota = ((midi % 12) + 12) % 12;
            var octava = Math.floor(midi / 12) - 1;
            if (estadoConfig.cifrado === "latino") {
                var nLat = NOMBRES_LATINO[indiceNota];
                return { visual: nLat + " " + octava, hablado: nLat + " " + octava };
            } else {
                var nAmer = NOMBRES_AMERICANO[indiceNota];
                return { visual: nAmer + octava, hablado: nAmer + " " + octava };
            }
        }

        var desviacionCentsActual = 0.0;
        var senalDetectadaActiva = false;

        function actualizarTelemetriaEstudio(hzDetectados, centsDesviacion) {
            desviacionCentsActual = centsDesviacion;
            lecturaHz.textContent = Number(hzDetectados).toFixed(2) + " Hz";
            var signo = centsDesviacion > 0.05 ? "+" : (centsDesviacion < -0.05 ? "" : "±");
            var valorCents = Math.abs(centsDesviacion) <= 0.05 ? "0.0" : centsDesviacion.toFixed(1);
            lecturaCents.textContent = signo + valorCents + " cents";
        }

        function notificarObjetivoAlMotor(hzObjetivo) {
            if (workletNode && workletNode.port) {
                workletNode.port.postMessage({
                    type: "config",
                    targetHz: hzObjetivo,
                    rmsThreshold: estadoConfig.umbralRms
                });
            }
        }

        function sincronizarClavijasYVisor() {
            var midiArray = CATALOGO_AFINACIONES[estadoConfig.indiceAfinacion];

            for (var idx = 0; idx < 6; idx++) {
                var boton = btnCuerdas[idx];
                var midi = midiArray[idx];
                var hz = midiAFrecuencia(midi);
                var nota = formatearNota(midi);
                var baseLabel = ORDINALES_CUERDA[idx] + ", " + nota.hablado;

                boton.textContent = nota.visual;
                boton.setAttribute("data-base-label", baseLabel);
                boton.setAttribute("data-nota-visual", nota.visual);
                boton.setAttribute("data-nota-hablada", nota.hablado);
                boton.setAttribute("data-hz", hz.toFixed(2));

                if (indiceCuerdaActiva === idx) {
                    boton.classList.add("activa");
                    boton.setAttribute("aria-pressed", "true");
                    boton.setAttribute("aria-label", baseLabel + ". Seleccionada");
                } else {
                    boton.classList.remove("activa");
                    boton.setAttribute("aria-pressed", "false");
                    boton.setAttribute("aria-label", baseLabel);
                }
            }

            if (indiceCuerdaActiva !== null) {
                var midiActivo = midiArray[indiceCuerdaActiva];
                var notaActiva = formatearNota(midiActivo);
                var hzActivo = midiAFrecuencia(midiActivo);
                notaGigante.textContent = notaActiva.visual;
                notaGigante.classList.add("nota-activa");
                actualizarFiltroFrancotirador(hzActivo);
                notificarObjetivoAlMotor(hzActivo);
                if (!microfonoActivo) {
                    actualizarTelemetriaEstudio(hzActivo, 0.0);
                }
            } else {
                var midiRef = midiArray[5];
                var notaRef = formatearNota(midiRef);
                var hzRef = midiAFrecuencia(midiRef);
                notaGigante.textContent = notaRef.visual;
                notaGigante.classList.remove("nota-activa");
                notificarObjetivoAlMotor(0);
                actualizarTelemetriaEstudio(hzRef, 0.0);
            }
        }

        function sincronizarControlesConfigUI() {
            var textoEstadoTimbre = estadoConfig.timbreActivo ? "Activado" : "Desactivado";
            btnToggleTimbre.setAttribute("aria-checked", estadoConfig.timbreActivo ? "true" : "false");
            btnToggleTimbre.setAttribute("aria-label", "Sonido de confirmación al afinar: " + textoEstadoTimbre);
            valorVisualTimbre.textContent = textoEstadoTimbre;

            for (var j = 0; j < botonesOpcionAfinacion.length; j++) {
                if (j === estadoConfig.indiceAfinacion) {
                    botonesOpcionAfinacion[j].classList.add("seleccionada");
                } else {
                    botonesOpcionAfinacion[j].classList.remove("seleccionada");
                }
            }
            var nombreAfinacion = NOMBRES_AFINACIONES[estadoConfig.indiceAfinacion];
            valorVisualAfinacion.textContent = nombreAfinacion;
            btnAbrirAfinacion.setAttribute("aria-label", "Afinación del instrumento: " + nombreAfinacion);

            for (var n = 0; n < botonesOpcionNomenclatura.length; n++) {
                var cif = botonesOpcionNomenclatura[n].getAttribute("data-cifrado");
                if (cif === estadoConfig.cifrado) {
                    botonesOpcionNomenclatura[n].classList.add("seleccionada");
                } else {
                    botonesOpcionNomenclatura[n].classList.remove("seleccionada");
                }
            }
            var textoCifrado = (estadoConfig.cifrado === "latino")
                ? "Latino (Do, Re, Mi)"
                : "Americano (C, D, E)";
            valorVisualNomenclatura.textContent = textoCifrado;
            btnAbrirNomenclatura.setAttribute("aria-label", "Nomenclatura de notas: " + textoCifrado);

            valorA4.textContent = estadoConfig.calibracionA4 + " Hz";
            valorA4.setAttribute("aria-label", "Frecuencia de referencia actual: " + estadoConfig.calibracionA4 + " hercios");
        }

        /* =====================================================================
           3. SELECCIÓN DE LAS 6 CLAVIJAS (MARCAR Y DESMARCAR)
           ===================================================================== */
        function reiniciarEstadoEstabilizador() {
            ventanaMediana.fill(0);
            totalMuestrasMediana = 0;
            cursorMediana = 0;
            frecuenciaSuavizada = 0;
            contadorSilencioFrames = 0;
            ultimaFraseAnunciada = "";
            inicioEnZonaAfinada = 0;
            timbreDisparadoEnEsteBloqueo = false;
            senalDetectadaActiva = false;
            desviacionCentsActual = 0.0;
        }

        function manejarClickCuerda(idx) {
            if (indiceCuerdaActiva === idx) {
                indiceCuerdaActiva = null;
                reiniciarEstadoEstabilizador();
                consolaCentral.classList.remove("afinado-lock");
                notaGigante.classList.remove("nota-afinada");
                sincronizarClavijasYVisor();
                display.textContent = "Cuerda desmarcada. Seleccione una cuerda para comenzar.";
                return;
            }

            indiceCuerdaActiva = idx;
            reiniciarEstadoEstabilizador();
            consolaCentral.classList.remove("afinado-lock");
            notaGigante.classList.remove("nota-afinada");

            sincronizarClavijasYVisor();

            var notaHablada = btnCuerdas[idx].getAttribute("data-nota-hablada");
            if (microfonoActivo) {
                display.textContent = "Afinando " + notaHablada + ". Escuchando...";
            } else {
                display.textContent = notaHablada + " seleccionada. Active el micrófono.";
            }
        }

        btnCuerdas[0].addEventListener("click", function() { manejarClickCuerda(0); });
        btnCuerdas[1].addEventListener("click", function() { manejarClickCuerda(1); });
        btnCuerdas[2].addEventListener("click", function() { manejarClickCuerda(2); });
        btnCuerdas[3].addEventListener("click", function() { manejarClickCuerda(3); });
        btnCuerdas[4].addEventListener("click", function() { manejarClickCuerda(4); });
        btnCuerdas[5].addEventListener("click", function() { manejarClickCuerda(5); });

        /* =====================================================================
           4. NAVEGACIÓN DEL PANEL DE CONFIGURACIÓN Y MODALES EMERGENTES
           ===================================================================== */
        btnConfig.addEventListener("click", function() {
            vistaPrincipal.style.display = "none";
            vistaConfig.style.display = "flex";
            setTimeout(function() { btnAtrasConfig.focus(); }, 40);
        });

        btnAtrasConfig.addEventListener("click", function() {
            vistaConfig.style.display = "none";
            vistaPrincipal.style.display = "flex";
            setTimeout(function() { btnConfig.focus(); }, 40);
        });

        btnToggleTimbre.addEventListener("click", function() {
            estadoConfig.timbreActivo = !estadoConfig.timbreActivo;
            sincronizarControlesConfigUI();
            guardarConfiguracionLocal();
        });

        function abrirModalAfinacion() {
            vistaConfig.setAttribute("aria-hidden", "true");
            modalAfinacion.style.display = "flex";
            var btnActual = botonesOpcionAfinacion[estadoConfig.indiceAfinacion];
            if (btnActual) {
                setTimeout(function() { btnActual.focus(); }, 40);
            }
